{
  "id": "cloud-ops",
  "version": "1.1.0",
  "title": {
    "ko": "클라우드 Ops",
    "en": "Cloud Ops"
  },
  "description": {
    "ko": "클라우드 인프라 작업에 특화 — K8s 컨텍스트, AWS 리전, Terraform 워크스페이스를 구름 아이콘 아래 정렬",
    "en": "Built for cloud infra work — K8s context, AWS region, and Terraform workspace lined up under a cloud icon"
  },
  "tool": "ccstatusline",
  "category": "custom",
  "tags": [
    "cloud",
    "kubernetes",
    "aws",
    "terraform",
    "symbol"
  ],
  "author": {
    "name": "neo",
    "github": "Brit-juho"
  },
  "ccstatusline_settings": {
    "version": 3,
    "defaultSeparator": " ",
    "lines": [
      [
        {
          "id": "1",
          "type": "custom-text",
          "rawValue": "☁",
          "color": "blue"
        },
        {
          "id": "2",
          "type": "custom-command",
          "commandPath": "kubectl config current-context",
          "color": "cyan",
          "bold": true
        },
        {
          "id": "3",
          "type": "custom-command",
          "commandPath": "aws configure get region",
          "color": "orange"
        },
        {
          "id": "4",
          "type": "custom-command",
          "commandPath": "terraform workspace show",
          "color": "magenta"
        },
        {
          "id": "6",
          "type": "context-percentage",
          "color": "dim"
        },
        {
          "id": "5",
          "type": "session-cost",
          "color": "dim"
        }
      ]
    ]
  }
}
