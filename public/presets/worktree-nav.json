{
  "id": "worktree-nav",
  "version": "1.0.0",
  "title": {
    "ko": "워크트리 내비",
    "en": "Worktree Nav"
  },
  "description": {
    "ko": "여러 워크트리를 오갈 때 길을 잃지 않는다 — 현재 워크트리, 브랜치, 원본 브랜치를 나침반처럼 표시",
    "en": "Never lose your way across worktrees — current worktree, branch, and original branch shown like a compass"
  },
  "tool": "ccstatusline",
  "category": "git",
  "tags": [
    "git",
    "worktree",
    "symbol"
  ],
  "author": {
    "name": "neo",
    "github": "Brit-juho"
  },
  "ccstatusline_settings": {
    "version": 3,
    "defaultSeparator": " ",
    "lines": [
      [
        {
          "id": "1",
          "type": "custom-text",
          "rawValue": "🌲",
          "color": "green"
        },
        {
          "id": "2",
          "type": "worktree-name",
          "color": "green",
          "bold": true
        },
        {
          "id": "3",
          "type": "worktree-branch",
          "color": "cyan"
        },
        {
          "id": "4",
          "type": "worktree-original-branch",
          "color": "dim"
        },
        {
          "id": "5",
          "type": "git-changes",
          "color": "yellow"
        },
        {
          "id": "7",
          "type": "context-percentage",
          "color": "dim"
        },
        {
          "id": "6",
          "type": "session-cost",
          "color": "dim"
        }
      ]
    ]
  }
}
