{
  "id": "context-guardian",
  "version": "1.1.0",
  "title": {
    "ko": "컨텍스트 가디언",
    "en": "Context Guardian"
  },
  "description": {
    "ko": "컨텍스트 창이 꽉 차기 전에 먼저 안다 — 사용량 바, %, 입출력 토큰을 나침반처럼 상시 감시",
    "en": "Know before the context window fills up — usage bar, %, and token flow watched like a compass"
  },
  "tool": "ccstatusline",
  "category": "productivity",
  "tags": [
    "context",
    "tokens",
    "productivity",
    "symbol"
  ],
  "author": {
    "name": "neo",
    "github": "Brit-juho"
  },
  "ccstatusline_settings": {
    "version": 3,
    "defaultSeparator": " ",
    "lines": [
      [
        {
          "id": "1",
          "type": "custom-text",
          "rawValue": "🧭",
          "color": "cyan"
        },
        {
          "id": "2",
          "type": "model",
          "color": "dim"
        },
        {
          "id": "3",
          "type": "context-bar",
          "color": "green",
          "bold": true
        },
        {
          "id": "4",
          "type": "tokens-input",
          "color": "dim"
        },
        {
          "id": "5",
          "type": "tokens-output",
          "color": "dim"
        },
        {
          "id": "6",
          "type": "tokens-cached",
          "color": "cyan"
        }
      ]
    ]
  }
}
