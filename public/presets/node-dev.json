{
  "id": "node-dev",
  "version": "1.1.0",
  "title": {
    "ko": "Node 개발자",
    "en": "Node Developer"
  },
  "description": {
    "ko": "Node.js 개발에 최적화 — Node 버전, 디렉터리, 브랜치, 비용을 육각형 아이콘 아래 한눈에",
    "en": "Optimized for Node.js dev — Node version, directory, branch, and cost lined up under a hex icon"
  },
  "tool": "ccstatusline",
  "category": "custom",
  "tags": [
    "node",
    "javascript",
    "dev",
    "symbol"
  ],
  "author": {
    "name": "neo",
    "github": "Brit-juho"
  },
  "ccstatusline_settings": {
    "version": 3,
    "defaultSeparator": " ",
    "lines": [
      [
        {
          "id": "1",
          "type": "custom-text",
          "rawValue": "⬢",
          "color": "green"
        },
        {
          "id": "2",
          "type": "custom-command",
          "commandPath": "node --version",
          "color": "green",
          "bold": true
        },
        {
          "id": "3",
          "type": "current-working-dir",
          "color": "blue"
        },
        {
          "id": "4",
          "type": "git-branch",
          "color": "cyan"
        },
        {
          "id": "5",
          "type": "model",
          "color": "dim"
        },
        {
          "id": "7",
          "type": "context-percentage",
          "color": "dim"
        },
        {
          "id": "6",
          "type": "session-cost",
          "color": "dim"
        }
      ]
    ]
  }
}
