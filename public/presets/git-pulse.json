{
  "id": "git-pulse",
  "version": "1.0.0",
  "title": {
    "ko": "Git 펄스",
    "en": "Git Pulse"
  },
  "description": {
    "ko": "Git 작업의 심장 박동 — 브랜치, ahead/behind, 변경 파일, 추가/삭제 라인까지 화살표로 압축",
    "en": "The heartbeat of your Git work — branch, ahead/behind, changed files, and insertions/deletions with arrows"
  },
  "tool": "ccstatusline",
  "category": "git",
  "tags": [
    "git",
    "branch",
    "diff",
    "symbol"
  ],
  "author": {
    "name": "neo",
    "github": "Brit-juho"
  },
  "ccstatusline_settings": {
    "version": 3,
    "defaultSeparator": " ",
    "lines": [
      [
        {
          "id": "1",
          "type": "custom-text",
          "rawValue": "🌿",
          "color": "green"
        },
        {
          "id": "2",
          "type": "git-branch",
          "color": "green",
          "bold": true
        },
        {
          "id": "3",
          "type": "git-ahead-behind",
          "color": "cyan"
        },
        {
          "id": "4",
          "type": "git-changes",
          "color": "yellow"
        },
        {
          "id": "5",
          "type": "git-insertions",
          "color": "green"
        },
        {
          "id": "6",
          "type": "git-deletions",
          "color": "red"
        },
        {
          "id": "8",
          "type": "context-percentage",
          "color": "dim"
        },
        {
          "id": "7",
          "type": "model",
          "color": "dim"
        }
      ]
    ]
  }
}
