{
  "id": "budget-radar",
  "version": "1.0.0",
  "title": {
    "ko": "예산 레이더",
    "en": "Budget Radar"
  },
  "description": {
    "ko": "지출과 한도를 레이더처럼 — 비용, 5h/7d 한도, 리셋 타이머까지 심볼로 한눈에 스캔",
    "en": "Scan spending like a radar — cost, 5h/7d limits, and reset timer, all symbol-marked"
  },
  "tool": "ccstatusline",
  "category": "cost",
  "tags": [
    "cost",
    "rate-limit",
    "budget",
    "reset",
    "symbol"
  ],
  "author": {
    "name": "neo",
    "github": "Brit-juho"
  },
  "ccstatusline_settings": {
    "version": 3,
    "defaultSeparator": " ",
    "lines": [
      [
        {
          "id": "1",
          "type": "custom-text",
          "rawValue": "💰",
          "color": "yellow"
        },
        {
          "id": "2",
          "type": "model",
          "color": "dim"
        },
        {
          "id": "3",
          "type": "session-cost",
          "color": "yellow",
          "bold": true
        },
        {
          "id": "4",
          "type": "session-usage",
          "color": "orange"
        },
        {
          "id": "5",
          "type": "weekly-usage",
          "color": "red"
        },
        {
          "id": "7",
          "type": "context-percentage",
          "color": "dim"
        },
        {
          "id": "6",
          "type": "reset-timer",
          "color": "dim"
        }
      ]
    ]
  }
}
