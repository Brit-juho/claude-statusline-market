{
  "id": "session-pulse",
  "version": "1.0.0",
  "title": {
    "ko": "세션 펄스",
    "en": "Session Pulse"
  },
  "description": {
    "ko": "세션의 맥박을 읽는다 — 경과 시간, 추론 수준, 세션명, 활성 스킬, 압축 횟수를 한 줄에",
    "en": "Read your session's pulse — elapsed time, thinking effort, session name, active skills, and compaction count"
  },
  "tool": "ccstatusline",
  "category": "productivity",
  "tags": [
    "session",
    "productivity",
    "skills",
    "symbol"
  ],
  "author": {
    "name": "neo",
    "github": "Brit-juho"
  },
  "ccstatusline_settings": {
    "version": 3,
    "defaultSeparator": " ",
    "lines": [
      [
        {
          "id": "1",
          "type": "custom-text",
          "rawValue": "◷",
          "color": "dim"
        },
        {
          "id": "2",
          "type": "session-clock",
          "color": "cyan",
          "bold": true
        },
        {
          "id": "3",
          "type": "model",
          "color": "dim"
        },
        {
          "id": "4",
          "type": "thinking-effort",
          "color": "dim"
        },
        {
          "id": "5",
          "type": "session-name",
          "color": "dim"
        },
        {
          "id": "6",
          "type": "skills",
          "color": "green"
        },
        {
          "id": "8",
          "type": "context-percentage",
          "color": "dim"
        },
        {
          "id": "7",
          "type": "compaction-counter",
          "color": "dim"
        }
      ]
    ]
  }
}
