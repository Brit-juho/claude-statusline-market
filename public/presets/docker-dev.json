{
  "id": "docker-dev",
  "version": "1.1.0",
  "title": {
    "ko": "Docker 개발자",
    "en": "Docker Developer"
  },
  "description": {
    "ko": "컨테이너 개발 환경 — Docker 컨텍스트, 브랜치, 변경 라인, 세션 비용을 고래 아이콘 아래",
    "en": "Container dev environment — Docker context, branch, diff lines, and cost under a whale icon"
  },
  "tool": "ccstatusline",
  "category": "custom",
  "tags": [
    "docker",
    "container",
    "dev",
    "symbol"
  ],
  "author": {
    "name": "neo",
    "github": "Brit-juho"
  },
  "ccstatusline_settings": {
    "version": 3,
    "defaultSeparator": " ",
    "lines": [
      [
        {
          "id": "1",
          "type": "custom-text",
          "rawValue": "🐳",
          "color": "blue"
        },
        {
          "id": "2",
          "type": "custom-command",
          "commandPath": "docker context show",
          "color": "blue",
          "bold": true
        },
        {
          "id": "3",
          "type": "git-branch",
          "color": "green"
        },
        {
          "id": "4",
          "type": "git-changes",
          "color": "yellow"
        },
        {
          "id": "6",
          "type": "context-percentage",
          "color": "dim"
        },
        {
          "id": "5",
          "type": "session-cost",
          "color": "dim"
        }
      ]
    ]
  }
}
