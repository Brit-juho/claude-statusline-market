---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/index.ts';
import { getBase } from '../../lib/utils.ts';
import { BuilderApp } from '../../components/Builder/BuilderApp.tsx';

const lang = 'en' as const;
const t = useTranslations(lang);
const base = getBase();

const translations = {
  palette_title: t('builder.palette_title'),
  canvas_title: t('builder.canvas_title'),
  config_title: t('builder.config_title'),
  canvas_empty: t('builder.canvas_empty'),
  config_empty: t('builder.config_empty'),
  preview_note: t('builder.preview_note'),
  preview_error: t('builder.preview_error'),
  download: t('builder.download'),
  copy_install: t('builder.copy_install'),
  copy_install_done: t('builder.copy_install_done'),
  apply_title: t('builder.apply_title'),
  apply_step1: t('builder.apply_step1'),
  apply_step2: t('builder.apply_step2'),
  back: t('builder.back'),
  tab_palette: t('builder.tab_palette'),
  tab_canvas: t('builder.tab_canvas'),
  tab_config: t('builder.tab_config'),
  a11y_drag_start: t('builder.a11y_drag_start'),
  a11y_drag_over: t('builder.a11y_drag_over'),
  a11y_drag_end: t('builder.a11y_drag_end'),
  a11y_drag_cancel: t('builder.a11y_drag_cancel'),
};
---
<Base title={t('builder.title')}>
  <div class="builder-page">
    <div class="builder-header">
      <a href={`${base}en/`} class="back-link">&larr; {t('builder.back')}</a>
      <div>
        <h1 class="builder-title">{t('builder.title')}</h1>
        <p class="builder-subtitle">{t('builder.subtitle')}</p>
      </div>
    </div>

    <BuilderApp
      client:only="preact"
      lang={lang}
      t={translations}
      base={base}
    />
  </div>
</Base>

<style>
.builder-page { padding: 2rem 1.5rem 4rem; max-width: 1200px; margin: 0 auto; }
.builder-header { margin-bottom: 2rem; }
.back-link { display: inline-block; font-size: 0.875rem; color: var(--text-dim); margin-bottom: 1rem; transition: color 0.15s; }
.back-link:hover { color: var(--text); }
.builder-title { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 0.375rem; }
.builder-subtitle { font-size: 0.9375rem; color: var(--text-dim); }
</style>
